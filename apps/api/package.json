{
  "name": "@eklesia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "devDependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@eklesia/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.13.14",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  }
}
