{
  "name": "eklesia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @eklesia/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @eklesia/shared build && pnpm --filter @eklesia/api build && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @eklesia/api db:generate",
    "db:migrate": "pnpm --filter @eklesia/api db:migrate",
    "db:seed": "pnpm --filter @eklesia/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
