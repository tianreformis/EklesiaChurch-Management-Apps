# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env ke git.

# Lingkungan aplikasi: development | production | test
NODE_ENV=development

# Nama aplikasi yang tampil di UI dan log
APP_NAME=Eklesia

# Alamat publik aplikasi. Dipakai untuk tautan undangan dan reset password.
# Gunakan https://... agar cookie sesi otomatis ditandai Secure.
APP_BASE_URL=http://127.0.0.1:5173

# Port HTTP aplikasi (di dalam kontainer aplikasi selalu 3000)
APP_PORT=3000
PORT=3000
HOST=0.0.0.0

# PostgreSQL (kredensial dipakai oleh layanan db di Docker Compose)
POSTGRES_DB=eklesia
POSTGRES_USER=eklesia
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# Port host untuk PostgreSQL saat development (diikat ke 127.0.0.1).
# Di produksi port ini tidak dipakai sama sekali (DB tidak dipublikasikan).
POSTGRES_PORT=55432

# Peran runtime aplikasi. Dibuat/diperbarui otomatis oleh `pnpm db:migrate`.
# Hanya mendapat hak DML sehingga Row Level Security berlaku.
APP_DB_USER=eklesia_app
APP_DB_PASSWORD=ganti-dengan-password-aplikasi

# Koneksi pemilik skema untuk migrasi dan seed (boleh melewati RLS).
MIGRATION_DATABASE_URL=postgres://eklesia:ganti-dengan-password-kuat@127.0.0.1:55432/eklesia

# Koneksi runtime aplikasi (peran terbatas).
# Di Docker Compose, nilai ini disusun otomatis dari POSTGRES_* / APP_DB_*.
DATABASE_URL=postgres://eklesia_app:ganti-dengan-password-aplikasi@127.0.0.1:55432/eklesia

# Lama sesi berlaku (hari)
SESSION_TTL_DAYS=7

# Tingkat log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Lokasi build SPA. Di Docker: /app/apps/web/dist (diset oleh compose).
# WEB_DIST_PATH=../../web/dist

# Folder lampiran bukti transaksi. Di Docker: /data/attachments (volume).
ATTACHMENT_DIR=data/attachments

# SMTP opsional. Tanpa SMTP, tautan undangan ditampilkan untuk dikirim manual.
# SMTP_HOST=smtp.contoh.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Eklesia <no-reply@contoh.com>"
